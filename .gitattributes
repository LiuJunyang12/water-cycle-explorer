# Normalise text files to LF in the repository, keep binaries untouched.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp3 binary
*.mp4 binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary

# Lock files and generated folders are never diffed by hand.
package-lock.json -diff
